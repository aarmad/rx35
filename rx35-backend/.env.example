# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne JAMAIS committer le fichier .env (clés secrètes).

PORT=3000

# Fournisseur de l'assistant IA : "gemini" (palier gratuit) ou "claude".
# Les deux partagent les mêmes prompts (src/services/aiPrompts.ts) ; seul
# le moteur change. Voir src/services/aiProvider.ts.
AI_PROVIDER=gemini

# Google Gemini — palier gratuit, sans carte bancaire.
# Obtention : aistudio.google.com -> "Get API key".
# ATTENTION au choix du modèle : gemini-2.5-flash est fermé aux nouveaux
# comptes, et les modèles Gemini 3 déduisent leurs jetons de "réflexion" du
# budget de réponse (le code envoie donc thinkingBudget: 0).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Clé API Anthropic — utilisée uniquement si AI_PROVIDER=claude.
# Obtention : console.anthropic.com -> "API Keys" -> "Create Key".
# Nécessite un moyen de paiement (facturation à l'usage, pas d'abonnement).
ANTHROPIC_API_KEY=

# Clé partagée que le boîtier RX35 (firmware) doit envoyer dans l'en-tête
# "X-Device-Key" pour pouvoir pousser des données. Changez cette valeur
# avant tout déploiement réel.
DEVICE_API_KEY=change-moi-device-key

# Secret utilisé pour signer les sessions utilisateur (JWT) de l'application
# mobile. Générez une valeur longue et aléatoire avant tout déploiement réel
# (ex. openssl rand -hex 32) — ne JAMAIS réutiliser la valeur d'exemple.
JWT_SECRET=change-moi-jwt-secret-tres-long-et-aleatoire

# Service météo (Open-Meteo ne nécessite pas de clé — laissé vide exprès)
WEATHER_LAT=6.1725
WEATHER_LON=1.2314

# Service satellite NDVI (Copernicus Data Space Ecosystem / Sentinel Hub)
# Laissez vide pour rester en mode simulé (voir src/services/satelliteService.ts)
#
# Obtention (gratuit) :
#   1. Créez un compte sur https://dataspace.copernicus.eu
#   2. Connectez-vous, survolez l'icône de profil (en haut à droite),
#      cliquez "Sentinel Hub" pour ouvrir le tableau de bord dédié
#   3. Dans "User Settings" -> "OAuth clients", créez un nouveau client :
#      vous obtenez immédiatement un Client ID et un Client Secret
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
